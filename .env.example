# Copy to .env (never commit .env). Everything here can also be set on the
# page under Settings; leave a line empty to skip that channel.

# How often the background worker checks every source, in minutes.
INTERNSHIP_REFRESH_MINUTES=30
# The address people open the app at, for links in emails and messages.
INTERNSHIPS_PUBLIC_URL=http://127.0.0.1:8700

# Email (Gmail: smtp.gmail.com, 587, your address, an app password)
INTERNSHIPS_SMTP_HOST=
INTERNSHIPS_SMTP_PORT=587
INTERNSHIPS_SMTP_USER=
INTERNSHIPS_SMTP_PASSWORD=
INTERNSHIPS_EMAIL_FROM=
INTERNSHIPS_EMAIL_TO=

# Telegram bot (from @BotFather) and the chat it posts to
INTERNSHIPS_TELEGRAM_BOT_TOKEN=
INTERNSHIPS_TELEGRAM_CHAT_ID=

# Slack or Discord incoming webhook, or any URL that takes JSON
INTERNSHIPS_WEBHOOK_URL=

# ntfy topic, for phone push with the ntfy app
INTERNSHIPS_NTFY_TOPIC=
